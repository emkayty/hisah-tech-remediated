# Required database connection (server only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Public canonical application URL. Use HTTPS outside local development.
NEXT_PUBLIC_APP_URL=https://example.com

# Transactional email (server only)
RESEND_API_KEY=re_...
EMAIL_FROM=Hisah Tech <noreply@example.com>

# Stripe card payments (server only)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Upload relay (server only)
APPGEN_UPLOAD_URL=https://upload.example.com
APP_ID=your-app-id
APP_UPLOAD_SECRET=replace-with-upload-secret

# AI assistance (server only)
OPENAI_API_KEY=replace-with-server-key
