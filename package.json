    "html2canvas": "1.4.1",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "0.468.0",
    "next": "16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "6.22.0",
    "stripe": "22.5.0",
    "tailwind-merge": "2.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "22.15.19",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
